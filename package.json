{
  "name": "dsh-client-ui-reasoning-slider",
  "version": "0.1.0",
  "type": "module",
  "description": "Codex-style reasoning-effort slider for the DeepSeek Harness composer: drag, click or arrow between effort levels instead of opening the model menu",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-client-plugin",
    "reasoning-effort",
    "slider",
    "custom-element",
    "web-components",
    "shadow-dom"
  ],
  "license": "MIT",
  "author": "NuoAug",
  "homepage": "https://github.com/NuoAug/dsh-client-ui-reasoning-slider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NuoAug/dsh-client-ui-reasoning-slider.git"
  },
  "bugs": {
    "url": "https://github.com/NuoAug/dsh-client-ui-reasoning-slider/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node tools/check-bundle.mjs lib/client.js && node tools/seat-smoke.mjs && node tools/check-inline.mjs lib/client.js lib/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1"
  }
}
